{
  "name": "lafarmer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev --workspace @lafarmer/web",
    "dev:server": "npm run dev --workspace @lafarmer/server"
  },
  "engines": {
    "node": ">=20"
  }
}
