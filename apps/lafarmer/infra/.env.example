# Local development defaults. Copy to .env; never commit real secrets.
POSTGRES_DB=lafarmer
POSTGRES_USER=lafarmer
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=55432
DATABASE_URL=postgresql://lafarmer:local-only-change-me@localhost:55432/lafarmer
SERVER_PORT=3348
WEB_PORT=4328
VITE_API_URL=http://localhost:3348
VITE_WS_URL=ws://localhost:3348/ws

# Dokploy / production values: set these in the Dokploy environment UI.
WEB_DOMAIN=lafarmer.example.com
SESSION_SECRET=replace-with-a-long-random-secret
# In production this must point to the private postgres service, not localhost.
# DATABASE_URL=postgresql://<user>:<password>@postgres:5432/<database>
