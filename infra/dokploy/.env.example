# Dokploy reads these values from the application environment. Do not commit
# real passwords, secrets, or volume names.
LOBBY_DOMAIN=gamegamegame.site
WHOAMI_DOMAIN=whoami.gamegamegame.site
IMPOSTOR_DOMAIN=impostor.gamegamegame.site
CARACOL_DOMAIN=caracol.gamegamegame.site
LAFARMER_DOMAIN=lafarmer.gamegamegame.site

# Compatibilidade com o ambiente LaFarmer já existente no Dokploy.
# O compose atual usa estes nomes para preservar o deploy sem recriar o banco.
WEB_DOMAIN=lafarmer.gamegamegame.site
POSTGRES_DB=lafarmer
POSTGRES_USER=lafarmer
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://lafarmer:<POSTGRES_PASSWORD>@postgres:5432/lafarmer
SESSION_SECRET=

# Must be the existing external Docker volume names used by production.
# Replace both values before running a compose config/deploy command.
CARACOL_POSTGRES_VOLUME=
LAFARMER_POSTGRES_VOLUME=

CARACOL_POSTGRES_PASSWORD=
CARACOL_VAPID_PUBLIC_KEY=
CARACOL_VAPID_PRIVATE_KEY=
CARACOL_VAPID_SUBJECT=mailto:caracol@gamegamegame.site

LAFARMER_POSTGRES_DB=lafarmer
LAFARMER_POSTGRES_USER=lafarmer
LAFARMER_POSTGRES_PASSWORD=
LAFARMER_SESSION_SECRET=
